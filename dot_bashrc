# shellcheck shell=bash
# ~/.bashrc — bash is the login shell; nushell is the daily driver.
#
# ~/.nu-handoff execs nushell for interactive shells, which is why ghostty,
# tmux, zellij, herdr and television need no nushell config of their own.
# Everything below the handoff is the rescue shell — SSH, a TTY, or a broken nu.
#
# Landmines:
#   - This file replaces /etc/skel/.bashrc, and `omarchy-reinstall-configs`
#     (also reached via `omarchy-reinstall`) does `cp -af /etc/skel/. ~/`.
#     Neither runs during `omarchy update`; re-run `chezmoi apply` after either.
#   - Nothing here is reached unless ~/.bash_profile (Arch) or ~/.profile
#     (Debian) sources it. Both belong to the distro and are not tracked here.

# Omarchy's OMARCHY_PATH/PATH bootstrap; a no-op everywhere else, so it needs no
# template guard. Above the interactive check because this file replaces
# /etc/skel/.bashrc, and non-interactive shells need PATH too.
# shellcheck source=/dev/null
[ -r /usr/share/omarchy/default/bash/env-bootstrap ] &&
    . /usr/share/omarchy/default/bash/env-bootstrap

# If not running interactively, don't do anything else.
case $- in
*i*) ;;
*) return ;;
esac

if [ -f "$HOME/.nu-handoff" ]; then
    # shellcheck source=/dev/null
    . "$HOME/.nu-handoff"
fi

# ─── Rescue shell ───────────────────────────────────────────────────────────
# Omarchy's rc gives aliases, functions, mise activate, starship, zoxide, fzf
# key-bindings, history options and inputrc, and tracks the package rather than
# a copy pinned here. OMARCHY_PATH is set by env-bootstrap above, so this is a
# runtime test rather than a second template branch.
if [ -n "$OMARCHY_PATH" ]; then
    # shellcheck source=/dev/null
    . "$OMARCHY_PATH/default/bash/rc"
else
    # Appended, matching what env-bootstrap does on Omarchy: system binaries
    # keep precedence over the mise shims.
    PATH="$PATH:$HOME/.local/share/mise/shims:$HOME/.local/bin"
    export PATH
fi
