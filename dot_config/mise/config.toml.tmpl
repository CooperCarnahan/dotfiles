{{- /* Unix family detection, same idiom as run_onchange_after_install_mise_toolchain.
       Defined at the top because both [tools] and [bootstrap.packages] need it —
       [tools] to pick where nushell comes from. */ -}}
{{- $arch := eq (includeTemplate "is-arch-family" .) "true" -}}
{{- $deb := false -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $deb = eq .chezmoi.osRelease.id "debian" -}}
{{- end -}}
{{- if and (not $deb) (hasKey .chezmoi.osRelease "idLike") -}}
{{-   $deb = contains "debian" .chezmoi.osRelease.idLike -}}
{{- end -}}
{{- $darwin := eq .chezmoi.os "darwin" -}}
[settings]
experimental = true

# Self-update the mise binary itself (not tools) before network-permitting
# commands, at most once per auto_update_check_duration (default 7d). Skipped
# in CI, offline, and non-interactive sessions. Global-only by design: a
# project config cannot opt us into replacing the mise binary.
auto_update = true

# Platforms written into mise.lock, which bootstrap installs from: a fresh box
# has no gh and no credential helper yet, so resolving `latest` for every tool
# anonymously blows the 60/hr API limit. Current platform is always included;
# a platform missing from the lock degrades to a live API call, not an error.
lockfile_platforms = ["linux-x64", "linux-arm64", "macos-arm64", "windows-x64"]

# gh keeps its token in the system keyring, so hosts.yml carries no
# oauth_token — and mise's gh_cli_tokens path parses that file directly rather
# than shelling out, so it finds nothing and falls back to an anonymous 60/hr.
# credential_command bridges that: `gh auth token` prints the keyring copy, so
# `gh auth login` stays the only thing to run and no plaintext token lands on
# disk (what --insecure-storage would have cost).
#
# MUST stay a bare command name, never an absolute path to the gh shim. mise
# has NO re-entrancy guard here — a credential_command that calls back into
# mise recurses until the process dies (measured: 25+ levels, no backstop).
# The only thing breaking the cycle is that mise strips its own shims dir from
# this subprocess's PATH, so a bare `gh` can resolve to a real binary but never
# to a shim. Naming the shim by absolute path defeats that and deadlocks
# bootstrap, where the shim's install would itself need the API.
#
# Cost of the guard: in contexts with no mise activation (cron, `ssh host
# 'cmd'`, GUI launchers), shims are the only gh on PATH, so stripping them
# leaves none and the token resolves to (none). That degrades to the anonymous
# limit, never an error — and bootstrap stays off the API via mise.lock.
[settings.github]
credential_command = "gh auth token"

# Shell-agnostic tool config, defined once for every shell that activates mise:
# nushell (via its pre_prompt hook) and the bash rescue shell alike.
#
# Scope limit: these arrive with mise's activation hook, so they reach nushell
# and anything launched from it (television cables, herdr panes, tuxedo), but
# NOT contexts with no activation — `ssh host 'cmd'`, cron, GUI launchers.
#
# Nushell-specific settings and PATH stay in env.nu; see the note there.
[env]
EDITOR = "nvim"
PAGER = "less -R"
BAT_PAGER = "less -R"
BAT_THEME = "TwoDark"
# Paths use single-quoted TOML literals: .chezmoi.homeDir contains backslashes
# on Windows, which a double-quoted string would read as escape sequences.
YAZI_CONFIG_HOME = '{{ .chezmoi.homeDir }}/.config/yazi'
CLIPBOARD_NOGUI = "1"

FZF_DEFAULT_COMMAND = "rg --files"
FZF_DEFAULT_OPTS = "-m --height 50% --border"

# tuxedo (todo.txt). Read by tuxedo itself and by cable/tuxedo.toml, which
# shells out to `tuxedo ls --json`.
TODO_DIR = '{{ .chezmoi.homeDir }}/Documents/todo'
TODO_FILE = '{{ .chezmoi.homeDir }}/Documents/todo/todo.txt'
DONE_FILE = '{{ .chezmoi.homeDir }}/Documents/todo/done.txt'

# lazy = true installs on first invocation instead of during `mise install`,
# which is what keeps bootstrap off the GitHub API. Eager is reserved for
# runtimes other things exec (bun, node), the shell-startup inits in env.nu,
# television cables, git's pager/hooks, and anything Claude Code spawns with a
# trimmed PATH. Backends outside the registry need lazy_bins: the shim has to
# exist before the tool does, and mise cannot know `beads` ships `bd` until it
# unpacks it.
[tools]
"github:dlvhdr/gh-dash" = { version = "latest", exe = "gh-dash", lazy = true, lazy_bins = ["gh-dash"] }
# Television cables shell out to this.
"github:webstonehq/tuxedo" = "latest"
{{- if not (or $arch $darwin) }}
# nushell only where no system package exists (Debian, Windows). Elsewhere it
# is a pacman:/brew: entry in [bootstrap.packages] instead: the shim is a
# symlink to mise itself, so reaching nu through it costs a second
# resolve-and-exec on every shell start (38ms vs 15ms measured), and
# ~/.nu-handoff runs before any `mise activate` could shorten that path.
"aqua:nushell/nushell" = "latest"
{{- end }}
"aqua:gastownhall/beads" = { version = "latest", lazy = true, lazy_bins = ["bd"] }
"aqua:ouch-org/ouch" = { version = "latest", lazy = true, lazy_bins = ["ouch"] }
atuin = "latest"
bat = "latest"
bun = "latest"
carapace = "latest"
cargo-binstall = { version = "latest", lazy = true }
ccache = "latest"
chezmoi = "latest"
claude = "latest"
cmake = { version = "latest", lazy = true }
codex = { version = "latest", lazy = true }
croc = { version = "latest", lazy = true }
delta = "latest"
difftastic = { version = "latest", lazy = true }
eza = { version = "latest", lazy = true }
fastfetch = { version = "latest", lazy = true }
fd = "latest"
fzf = "latest"
gh = "latest"
"github:agavra/tuicr" = { version = "latest", lazy = true, lazy_bins = ["tuicr"] }
"github:can1357/oh-my-pi" = { version = "latest", lazy = true, lazy_bins = ["omp"] }
go = { version = "latest", lazy = true }
hyperfine = { version = "latest", lazy = true }
jq = "latest"
jujutsu = { version = "latest", lazy = true }
lazygit = { version = "latest", lazy = true }
neovim = "latest"
ninja = "latest"
node = "latest"
"npm:@agentclientprotocol/claude-agent-acp" = "latest"
"npm:@colbymchenry/codegraph" = "latest"
"npm:context-mode" = "latest"
opencode = { version = "latest", lazy = true }
pitchfork = { version = "latest", lazy = true }
prek = "latest"
ripgrep = "latest"
# Registry shorthand resolves to the same github:rtk-ai/rtk. Eager: a Claude
# Code hook rewrites every Bash call through it.
rtk = "latest"
rust = { version = "latest", lazy = true }
starship = "latest"
television = "latest"
tmux = { version = "latest", lazy = true }
topgrade = { version = "latest", lazy = true }
tree-sitter = "latest"
uv = { version = "latest", lazy = true }
watchexec = { version = "latest", lazy = true }
witr = { version = "latest", lazy = true }
worktrunk = "latest"
yazi = { version = "latest", lazy = true }
zellij = { version = "latest", lazy = true }
zoxide = "latest"

{{ if ne .chezmoi.os "windows" -}}
# Eager: $env.CARAPACE_BRIDGES spawns fish for completions on every Tab.
"aqua:fish-shell/fish-shell" = "latest"
"github:agent-of-empires/agent-of-empires" = { version = "latest", exe = "aoe-linux-amd64", rename_exe = "aoe", lazy = true, lazy_bins = ["aoe"] }
# Not the `herdr` registry shorthand -- that resolves to herdrdev/herdr, a
# different project.
"github:ogulcancelik/herdr" = { version = "latest", lazy = true, lazy_bins = ["herdr"] }
{{- end }}

[tasks.bootstrap]
description = "Converge this machine: packages + tools + dotfiles"
# Deliberately not --force. That flag is global, not removal-scoped: it
# suppresses the "has changed since chezmoi last wrote it" prompt for all
# managed targets and silently reverts local edits with no output. Bootstrap is
# run by a human at a terminal, so a prompt is answerable -- and it is the only
# thing that surfaces drift from the nine ~/.local/bin stubs that still run
# `mise use -g` against this very file.
run = "chezmoi apply"

[tasks.update]
description = "Update dotfiles, system packages, and tools with Topgrade"
confirm = "Run the full Topgrade update? This can take a while."
# Topgrade applies chezmoi first, which restores the committed lockfile, then
# upgrades tools -- leaving the lock current for this platform only. Refresh
# the rest and push it back to the source dir, or the next apply reverts it.
run = ["topgrade", "mise lock --global", "chezmoi re-add ~/.config/mise/mise.lock"]

[tasks.update-unattended]
description = "Update everything non-interactively with Topgrade"
run = ["topgrade --yes --no-ask-retry", "mise lock --global", "chezmoi re-add ~/.config/mise/mise.lock"]

{{- if or $arch $deb $darwin }}

# System packages (OS/build packages + GUI apps), applied by
# `mise bootstrap packages apply --yes` in run_onchange_after_install_mise_toolchain.
# AUR packages can't live here (mise has no AUR backend) — they stay in
# run_onchange_after_setup_aur_packages. Windows (winget/scoop) is likewise
# script-driven. Entries are template-gated per OS family rather than relying on
# mise's own manager filtering, because mise's `brew` manager also runs on Linux —
# ungated brew: entries would drag Linuxbrew onto arch/debian boxes.
[bootstrap.packages]
{{ if $arch -}}
"pacman:base" = "latest"
"pacman:base-devel" = "latest"
"pacman:ctags" = "latest"
"pacman:dfu-util" = "latest"
"pacman:docker" = "latest"
"pacman:docker-compose" = "latest"
"pacman:dtc" = "latest"
"pacman:gperf" = "latest"
"pacman:make" = "latest"
# The interactive shell. A system package, not a mise tool — see [tools].
"pacman:nushell" = "latest"
"pacman:openssh" = "latest"
"pacman:socat" = "latest"
"pacman:sudo" = "latest"
"pacman:tk" = "latest"
"pacman:tree" = "latest"
"pacman:unzip" = "latest"
"pacman:which" = "latest"
"pacman:wget" = "latest"
# zsh is what makes the `zsh` entry in $env.CARAPACE_BRIDGES (env.nu) real —
# carapace shells out to it for completion specs it can only bridge from zsh.
# macOS ships it; Linux does not, so without this the bridge silently no-ops on
# every Arch/Debian box. NB: not needed as a fallback shell here — bash is the
# login shell on Linux and ~/.bashrc is the rescue path.
"pacman:zsh" = "latest"
{{ if eq (includeTemplate "is-headless" .) "false" -}}
# Desktop / Wayland stack — skipped on headless machines.
"pacman:ghostty" = "latest"
# Omarchy owns the display manager, lock screen, logout menu and screenshots.
# Installing gdm here also re-enabled it over sddm on every apply.
{{ end -}}
{{ end -}}
{{ if $deb -}}
"apt:build-essential" = "latest"
"apt:pkg-config" = "latest"
"apt:libssl-dev" = "latest"
"apt:ca-certificates" = "latest"
"apt:curl" = "latest"
"apt:git" = "latest"
"apt:unzip" = "latest"
# See the pacman:zsh note above — the carapace bridge needs it fleet-wide.
"apt:zsh" = "latest"
{{ end -}}
{{ if $darwin -}}
# mise's brew backend needs no preinstalled Homebrew (it creates /opt/homebrew
# itself, one sudo prompt on a brew-less mac).
"brew:ctags" = "latest"
"brew:dfu-util" = "latest"
"brew:dtc" = "latest"
"brew:gperf" = "latest"
"brew:make" = "latest"
# See the pacman:nushell note. Homebrew's prefix is not in path_helper, so
# ~/.nu-handoff probes /opt/homebrew/bin itself before giving up.
"brew:nushell" = "latest"
"brew:socat" = "latest"
"brew:tree" = "latest"
"brew:wget" = "latest"
"brew-cask:1password" = "latest"
"brew-cask:1password-cli" = "latest"
"brew-cask:ghostty" = "latest"
"brew-cask:zen-browser" = "latest"
{{ end -}}
{{- end }}
