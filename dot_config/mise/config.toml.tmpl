[tasks.bootstrap]
description = "Converge this machine: packages + tools + dotfiles"
run = "chezmoi apply"

[tasks.update]
description = "Update dotfiles, system packages, and tools with Topgrade"
confirm = "Run the full Topgrade update? This can take a while."
run = "topgrade"

[tasks.update-unattended]
description = "Update everything non-interactively with Topgrade"
run = "topgrade --yes --no-ask-retry"

{{- /* Unix family detection, same idiom as run_onchange_after_install_mise_toolchain. */ -}}
{{- $arch := eq (includeTemplate "is-arch-family" .) "true" -}}
{{- $deb := false -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $deb = eq .chezmoi.osRelease.id "debian" -}}
{{- end -}}
{{- if and (not $deb) (hasKey .chezmoi.osRelease "idLike") -}}
{{-   $deb = contains "debian" .chezmoi.osRelease.idLike -}}
{{- end -}}
{{- $darwin := eq .chezmoi.os "darwin" -}}
{{- if or $arch $deb $darwin }}

# System packages (OS/build packages + GUI apps), applied by
# `mise bootstrap packages apply --yes` in run_onchange_after_install_mise_toolchain.
# AUR packages can't live here (mise has no AUR backend) — they stay in
# run_onchange_after_setup_aur_packages. Windows (winget/scoop) is likewise
# script-driven. Entries are template-gated per OS family rather than relying on
# mise's own manager filtering, because mise's `brew` manager also runs on Linux —
# ungated brew: entries would drag Linuxbrew onto arch/debian boxes.
[bootstrap.packages]
{{ if $arch -}}
"pacman:base" = "latest"
"pacman:base-devel" = "latest"
"pacman:ctags" = "latest"
"pacman:dfu-util" = "latest"
"pacman:docker" = "latest"
"pacman:docker-compose" = "latest"
"pacman:dtc" = "latest"
# pacman:git removed: it is a DIRECT dependency of the `omarchy` package
# (verified: `pacman -Qi omarchy` -> Depends On: ... git ...), so on the desktop
# this repo actually targets it is always present and listing it here only adds
# a second declared owner.
#
# CAVEAT, deliberately accepted: git is NOT in the base-devel group (checked --
# base-devel is autoconf/automake/binutils/.../which, no git), and this block is
# ungated, so it also covers plain-Arch and headless-Arch boxes where nothing
# else guarantees git. The only code path that would then break is the paru
# bootstrap in run_onchange_after_setup_aur_packages, which runs `git clone` --
# and only on a non-Omarchy Arch box that has neither paru nor yay. It fails
# loudly under `set -e` rather than silently. Re-add this line if that combination
# ever becomes a real target.
"pacman:gperf" = "latest"
"pacman:make" = "latest"
"pacman:openssh" = "latest"
"pacman:socat" = "latest"
"pacman:sudo" = "latest"
"pacman:tk" = "latest"
"pacman:tree" = "latest"
"pacman:unzip" = "latest"
"pacman:which" = "latest"
"pacman:wget" = "latest"
{{ if eq (includeTemplate "is-headless" .) "false" -}}
# Desktop / Wayland stack — skipped on headless machines.
"pacman:ghostty" = "latest"
# gdm/hyprlock/wlogout/hyprshot removed: Omarchy owns the display manager
# (sddm), the lock screen (Quickshell, configured via
# ~/.config/omarchy/shell.json), the logout menu, and screenshots
# (`omarchy capture screenshot|region|text`). Installing gdm here also
# re-enabled it over sddm on every apply.
# Also cut, each for its own reason:
#   wtype       -> `pacman -Qi wtype` says Required By: None, and nothing in
#                  this repo references it. `omarchy clipboard paste text`
#                  covers the use case.
#   xsensors    -> not installed, zero references. btop + `omarchy hw` cover it.
#   xdg-desktop-portal-hyprland -> another DIRECT `omarchy` dependency.
"pacman:zen-browser-bin" = "latest"
{{ end -}}
{{ end -}}
{{ if $deb -}}
"apt:build-essential" = "latest"
"apt:pkg-config" = "latest"
"apt:libssl-dev" = "latest"
"apt:ca-certificates" = "latest"
"apt:curl" = "latest"
"apt:git" = "latest"
"apt:unzip" = "latest"
{{ end -}}
{{ if $darwin -}}
# mise's brew backend needs no preinstalled Homebrew (it creates /opt/homebrew
# itself, one sudo prompt on a brew-less mac).
"brew:ctags" = "latest"
"brew:dfu-util" = "latest"
"brew:dtc" = "latest"
"brew:gperf" = "latest"
"brew:make" = "latest"
"brew:socat" = "latest"
"brew:tree" = "latest"
"brew:wget" = "latest"
"brew-cask:1password" = "latest"
"brew-cask:1password-cli" = "latest"
"brew-cask:ghostty" = "latest"
"brew-cask:zen-browser" = "latest"
{{ end -}}
{{- end }}
