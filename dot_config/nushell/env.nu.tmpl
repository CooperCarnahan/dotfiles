# env.nu
# Installed by:
# version = "0.114.0"

# Shell-agnostic tool config lives in [env] in mise/config.toml.tmpl. This file
# keeps only what mise cannot express.

# Nushell config, not an environment variable.
$env.config.edit_mode = 'vi'

# Contains both single and double quotes; correct as-is here, would need
# re-quoting to survive TOML.
$env.MANPAGER = "sh -c 'awk \"{ gsub(/\\x1B\\[[0-9;]*m/, \\\"\\\", \$0); gsub(/.\\x08/, \\\"\\\", \$0); print }\" | bat -p -lman'"

# PATH belongs here, not in mise: `++=` APPENDS, so these lose to both /usr/bin
# and mise's own tool dirs. mise's `_.path` PREPENDS, which would let a stale
# ~/.local/bin binary shadow the mise-managed one.
{{- if eq .chezmoi.os "windows"}}
$env.XDG_CONFIG_HOME = $env.USERPROFILE + '/.config'
$env.XDG_STATE_HOME = $env.USERPROFILE + '/.local/state'
$env.ZELLIJ_CONFIG_DIR = $env.USERPROFILE + '/.config/zellij'

$env.path ++= [($nu.home-dir | path join '.local' 'bin')]

# rust
$env.path ++= [($nu.home-dir | path join '.cargo' 'bin')]

# golang
$env.path ++= [($nu.home-dir | path join 'go' 'bin')]

{{- else }}
$env.path ++= [($nu.home-dir | path join '.local' 'bin')]

# rust
$env.path ++= [($nu.home-dir | path join '.cargo' 'bin')]

# golang
$env.path ++= [($nu.home-dir | path join 'go' 'bin')]
$env.path ++= ["/usr/local/go/bin"]
{{- end }}

# carapace bridges: completion fallbacks to other shells. Read at runtime by the
# carapace binary (NOT baked into its init, so not a cache input). Trimmed on
# Windows, where zsh/fish/bash aren't present and spawn slowly on every Tab.
{{- if eq .chezmoi.os "windows" }}
$env.CARAPACE_BRIDGES = ''
{{- else }}
$env.CARAPACE_BRIDGES = 'zsh,fish,bash'
{{- end }}


# Tool integrations via vendor autoload. Mise activation is fresh per shell;
# other integrations are memoized: regenerate a tool's init only
# when nushell or the resolved binary changed (key stored as the first line),
# written atomically. Never delete on absence — keep last-good so a cold shell
# (tool not yet on PATH) still loads working integrations. Each call is guarded
# so one tool failing can't abort the rest of env.nu. env.nu runs before the
# autoload dir is sourced, so a regenerated init takes effect in the SAME shell.
let autoload_dir = $nu.data-dir | path join "vendor/autoload"
mkdir $autoload_dir

def cache-file [name: string, file: path, gen: closure] {
  try {
    let found = (which -a $name | where type == external)
    if ($found | is-empty) { return }
    # Resolve mise's dispatch shim BEFORE following its symlink to mise itself.
    let command_path = ($found | get 0.path)
    let bin = (if ($command_path | str replace -a '\' '/' | str contains '/mise/shims/') {
      let resolved = (^mise which $name | complete)
      if $resolved.exit_code != 0 {
        error make {msg: $"Cannot resolve mise tool ($name): ($resolved.stderr)"}
      }
      $resolved.stdout | str trim | path expand
    } else { $command_path | path expand })
    # scoop shims are stable trampolines whose mtime/size never change across
    # upgrades — key on the shim's target (from the sibling .shim manifest)
    # or the cache would never invalidate (bit us with mise on Windows).
    let shim_manifest = (if ($bin | str ends-with ".exe") {
      $bin | str replace -r '\.exe$' '.shim'
    } else { "" })
    let bin = (if ($shim_manifest | path exists) {
      open $shim_manifest --raw | lines | where ($it | str starts-with "path")
        | first | split row "=" | last | str trim | str trim -c '"'
    } else { $bin })
    let st = (ls $bin | get 0)
    # epoch, not ($st.modified): interpolated datetimes render a relative suffix
    # ("(18 minutes ago)") that changes over time and churns the key every startup
    let tag = $"# cache-key: nu=(version | get version)|bin=($bin)|m=($st.modified | into int)|s=($st.size | into int)"
    let cur = (if ($file | path exists) { open $file --raw | lines | first } else { "" })
    # Mise activation embeds the incoming PATH, which is shell-specific.
    # Refresh it each startup; stable tool integrations remain cached.
    if $name == 'mise' or $cur != $tag {
      let tmp = $"($file).tmp"
      let body = (do $gen | collect)
      [$tag, $body] | str join (char nl) | save --force $tmp
      mv --force $tmp $file
    }
  } catch {|e| print $"[env.nu] cache-file ($name) failed: ($e.msg)" }
}

def cache-init [item: record<priority: int, name: string, init: list<string>>] {
  let priority = if $item.priority < 10 {
    $"0($item.priority)"
  } else {
    $"($item.priority)"
  }
  cache-file $item.name ($autoload_dir | path join $"($priority)-($item.name).nu") {||
    # Generate from a mise-less env: `mise activate` run from an already-active
    # shell bakes an "undo the parent activation" preamble (hardcoded PATH
    # snapshot) into its output. Cached, that snapshot clobbers PATH in nested
    # shells, and hook-env won't repair it — the inherited __MISE_SESSION says
    # nothing changed, so every mise-managed tool vanishes (zoxide errors first).
    hide-env -i __MISE_DIFF __MISE_SESSION __MISE_WATCH MISE_SHELL
    ^$item.name ...$item.init | collect
  }
}

# Lower numbers load earlier. Only constraint today: atuin (90) must load after
# tv (10) so atuin keeps ctrl-r (tv overrides only ctrl-r; atuin's up-arrow
# directory search is untouched). Files orphaned by a rename are pruned by the
# chezmoi run_onchange reconcile script (it matches the "# cache-key:" marker
# these files carry), so no cleanup is needed here.
let init_configs = [
  { priority: 00, name: mise,     init: [activate nu] }
  { priority: 10, name: tv,       init: [init nu] }
  { priority: 20, name: zoxide,   init: [init nushell] }
  { priority: 30, name: starship, init: [init nu] }
  { priority: 40, name: carapace, init: [_carapace nushell] }
  { priority: 50, name: wt,       init: [config shell init nu] }
  { priority: 90, name: atuin,    init: [init nu] }
]

for item in $init_configs {
  cache-init $item
}
