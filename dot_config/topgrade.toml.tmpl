[misc]
# Apply the latest dotfile declarations before package managers and mise run.
# Chezmoi only provisions; it never invokes Topgrade, so this cannot recurse.
first = ["chezmoi"]

# Topgrade itself is mise-owned and is updated by the mise step.
disable = ["self_update"]

[mise]
# Respect the chezmoi-managed "latest" declarations without rewriting them.
bump = false

{{- if eq (includeTemplate "is-arch-family" .) "true" }}
[linux]
# A full AUR-helper transaction updates repository and AUR packages together,
# avoiding Arch partial upgrades. Omarchy preinstalls yay and never grows a paru,
# so name the one that is actually there — topgrade fails if it is missing.
arch_package_manager = "{{ if eq (includeTemplate "is-omarchy" .) "true" }}yay{{ else }}paru{{ end }}"
{{- end }}
