# ~/.zshrc — zsh is the login shell on macOS; nushell is the daily driver.
#
# ~/.nu-handoff execs nushell for interactive shells, so on macOS this is the
# whole path from login to nu. On Linux bash is the login shell, so this file is
# only reached when you deliberately run zsh — but it deploys everywhere so zsh
# behaves the same on every machine.
#
# Deliberately not Omarchy-aware: its rc chain is bash syntax (it calls `bind
# -f`, a bash builtin), so zsh must not source it. A zsh login shell on Omarchy
# still gets OMARCHY_PATH from /etc/profile.d.
#
# Everything below the handoff is the rescue shell: a broken nu, macOS SSH or
# Terminal.app. It stays small rather than reproducing nushell's setup in a
# second language.

if [[ -f "$HOME/.nu-handoff" ]]; then
    source "$HOME/.nu-handoff"
fi

# ─── Rescue shell ───────────────────────────────────────────────────────────
# The handoff finds nu by itself, so PATH here is rescue-only. Appended, so
# system binaries keep precedence over the mise shims.
typeset -U path PATH
path+=("$HOME/.local/share/mise/shims" "$HOME/.local/bin")

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

bindkey -v
bindkey -M viins 'jk' vi-cmd-mode

# atuin alone, because its history is shared with nushell — the whole point of
# this shell is recovering from whatever you just ran in nu. A prompt, jump and
# completion stack would only decorate a shell you are trying to leave.
if command -v atuin > /dev/null; then
    eval "$(atuin init zsh)"
fi
