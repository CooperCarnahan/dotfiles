{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}
{{- $work := false -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $work = promptBoolOnce . "work" "Is this a work machine?" -}}
{{- end -}}
{{- /* Desktop vs headless — a Linux-only concept (Windows/macOS boxes always have
       a desktop, so don't even prompt there). Default: headless on any Linux that
       isn't Arch/CachyOS (those are the desktop boxes). Drives .chezmoiignore +
       desktop packages. */ -}}
{{- $headless := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $headlessDefault := false -}}
{{-   if hasKey .chezmoi.osRelease "id" -}}
{{-     $headlessDefault = not (or (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.osRelease.id "cachyos")) -}}
{{-   end -}}
{{-   $headless = promptBoolOnce . "headless" "Is this a headless machine (no desktop / Wayland session)?" $headlessDefault -}}
{{- end -}}
{{- /* Windows-only opt-ins. Both are read by consumers via `dig` with a false/empty
       default, so a machine that has not re-run `chezmoi init` since these were added
       degrades to "feature off" rather than failing on a missing map key. */ -}}
{{- /* Tweaks and app removal are SEPARATE consents. They differ in kind: tweaks change
       telemetry, services and Explorer defaults, while removal uninstalls software. A
       work machine may reasonably want neither, one, or both. Keeping them separate also
       sidesteps a Win11Debloat trap: -RunDefaults calls AddParameter 'Apps' 'Default',
       which OVERWRITES any -Apps list, so "apply the defaults" and "keep Teams/To Do"
       cannot be expressed through that flag at all. */ -}}
{{- $windowsTweaks := false -}}
{{- $removeApps := false -}}
{{- $sshServer := false -}}
{{- $sshAuthorizedKey := "" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $windowsTweaks = promptBoolOnce . "windowsTweaks" "Apply Windows tweaks (disable telemetry, ads, suggestions; fix Explorer defaults)?" (not $work) -}}
{{-   $removeApps = promptBoolOnce . "removeApps" "Remove preinstalled apps (Bing, Copilot, Solitaire, third-party games)?" (not $work) -}}
{{- /* Opening an inbound listener is security-relevant and varies per machine, so it
       defaults to off rather than following `work`. NB: a template comment must be
       `{{- /*` exactly -- extra spaces after the trim marker make the lexer parse it as
       an action instead ("unexpected / in command"). */ -}}
{{-   $sshServer = promptBoolOnce . "sshServer" "Enable the OpenSSH server on this machine (inbound SSH)?" false -}}
{{-   if $sshServer -}}
{{- /* `fail`, not the silent lookPath skip used by pushoverUrl below: a silently empty
       Pushover URL costs a notification, a silently empty authorized_keys locks you out
       of the machine you just enabled SSH on. */ -}}
{{-     if not (lookPath "op") -}}
{{-       fail "sshServer requires the 1Password CLI. Run 'winget install AgileBits.1Password.CLI', sign in, then re-run 'chezmoi init'." -}}
{{-     end -}}
{{-     $sshAuthorizedKey = onepasswordRead "op://Personal/SSH Key - Inter-Computer/public key" -}}
{{-   end -}}
{{- end -}}
{{- $pushoverUrl := "" -}}
{{- if and (not $work) (lookPath "op") -}}
{{-   $pushover := onepasswordDetailsFields "Pushover API Credentials" -}}
{{-   $pushoverUrl = printf "pover://%s@%s" $pushover.username.value $pushover.credential.value -}}
{{- end -}}

[data]
    osid = {{ $osid | quote }}
    work = {{ $work }}
    headless = {{ $headless }}
    pushoverUrl = {{ $pushoverUrl | quote }}
    windowsTweaks = {{ $windowsTweaks }}
    removeApps = {{ $removeApps }}
    sshServer = {{ $sshServer }}
    sshAuthorizedKey = {{ $sshAuthorizedKey | quote }}

[interpreters.ps1]
    command = "powershell"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass"]

# Nushell is used only by AFTER-phase scripts, after mise has provisioned it.
[interpreters.nu]
    command = "nu"
    args = ["--stdin"]

[diff]
    command = "difft"
    args = [
        "--color", "always",
        "--skip-unchanged",
        "{{ `{{ .Destination }}` }}",
        "{{ `{{ .Target }}` }}"
    ]
    pager = "less -R"

# Canonicalize JSON only for display. Native modify templates preserve the live
# bytes on semantic no-ops; when a managed value really changes, this prevents
# object-key ordering from obscuring that change in difftastic's output.
[[textconv]]
    pattern = "**/*.json"
    command = "jq"
    args = ["--sort-keys", "."]

[merge]
    command = "nvim"
    args = [
        "-d",
        "{{ `{{ .Destination }}` }}",
        "{{ `{{ .Source }}` }}",
        "{{ `{{ .Target }}` }}"
    ]
