{{- if eq .chezmoi.os "windows" -}}
{{- /* Active tag set. Entries in .chezmoidata/packages.toml with no `tags` apply
       everywhere; tagged entries need one of theirs to be active. hasKey is mandatory --
       a bare `.tags` on an untagged entry is a hard template error, not a nil. Only the
       selected IDs are rendered below, so comment-only or irrelevant-tag edits in the
       data file do not churn this script's run_onchange_ hash. */ -}}
{{- $tags := list "base" -}}
{{- if not .work }}{{ $tags = append $tags "personal" }}{{ end -}}
$ErrorActionPreference = 'Continue'
$ProgressPreference = 'SilentlyContinue'

function Write-Step {
    param([string]$Message)
    Write-Host "`n==> $Message" -ForegroundColor Cyan
}

function Refresh-SessionEnvironment {
    Write-Host "Refreshing environment variables from registry..." -ForegroundColor Gray

    $machinePath = [System.Environment]::GetEnvironmentVariable("Path", "Machine")
    $userPath = [System.Environment]::GetEnvironmentVariable("Path", "User")
    $env:Path = "$machinePath;$userPath"
}

# Collected across the whole run rather than aborting on the first failure: one transient
# package hiccup should not mask the other twenty. Reported and exited non-zero at the end
# so chezmoi does NOT record this run_onchange_ script as done — otherwise a missing
# package would never be retried. This is exactly how the PowerToys breakage went unnoticed.
$Failed = @()

# 0x8A150061 as a signed int. Returned under --no-upgrade when the package is already
# present, which is the steady state on every apply after the first.
$NoApplicableUpdate = -1978335135

{{- if .work }}
Write-Host "`n[MODE: WORK]" -ForegroundColor Magenta
{{- else }}
Write-Host "`n[MODE: PERSONAL]" -ForegroundColor Magenta
{{- end }}

# 1. WinGet Package Installs
Write-Step "Installing packages via WinGet"

$packages = @(
{{- range $p := .windows.winget }}
{{-   $want := true }}
{{-   if hasKey $p "tags" }}
{{-     $want = false }}
{{-     range $t := $p.tags }}{{ if has $t $tags }}{{ $want = true }}{{ end }}{{ end }}
{{-   end }}
{{-   if $want }}
    {{ $p.id | quote }}
{{-   end }}
{{- end }}
)

$msstorePackages = @(
{{- range $p := .windows.msstore }}
{{-   $want := true }}
{{-   if hasKey $p "tags" }}
{{-     $want = false }}
{{-     range $t := $p.tags }}{{ if has $t $tags }}{{ $want = true }}{{ end }}{{ end }}
{{-   end }}
{{-   if $want }}
    {{ $p.id | quote }}  # {{ $p.name }}
{{-   end }}
{{- end }}
)

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    # A hard failure, not a warning-and-skip: silently producing an unprovisioned machine
    # is worse than stopping with an actionable message.
    throw "WinGet not found. Install 'App Installer' from the Microsoft Store, then re-run 'chezmoi apply'."
}

# Seed winget's settings BEFORE the first install. That file is a file-phase target, which
# chezmoi writes only after this before-phase script has finished -- so on a fresh machine
# every package below would otherwise install before the "scope: user" preference existed,
# at winget's default (often machine) scope. Content is shared with the managed target via
# .chezmoitemplates/winget-settings.json, so there is still exactly one source of truth.
$WingetSettings = Join-Path $env:LOCALAPPDATA "Packages\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\LocalState\settings.json"
if (-not (Test-Path -LiteralPath $WingetSettings)) {
    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $WingetSettings) | Out-Null
    Set-Content -LiteralPath $WingetSettings -Encoding UTF8 -Value @'
{{ includeTemplate "winget-settings.json" . }}
'@
    Write-Host "Seeded winget settings (user scope, telemetry off)" -ForegroundColor Gray
}

foreach ($pkg in $packages) {
    Write-Host "Installing $pkg..." -ForegroundColor Gray
    # --no-upgrade keeps apply present-only; Topgrade owns all upgrades.
    winget install --id $pkg --exact --silent --no-upgrade `
        --accept-source-agreements --accept-package-agreements
    $code = $LASTEXITCODE
    if ($code -ne 0 -and $code -ne $NoApplicableUpdate) { $Failed += "winget $pkg (exit $code)" }
}

foreach ($pkg in $msstorePackages) {
    Write-Host "Installing $pkg (msstore)..." -ForegroundColor Gray
    # Store-only packages with no winget-community manifest. Same present-only policy.
    winget install --id $pkg --source msstore --exact --silent --no-upgrade `
        --accept-source-agreements --accept-package-agreements
    $code = $LASTEXITCODE
    if ($code -ne 0 -and $code -ne $NoApplicableUpdate) { $Failed += "msstore $pkg (exit $code)" }
}

Refresh-SessionEnvironment

# 2. Scoop Setup
Write-Step "Checking Scoop installation"
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Host "Installing Scoop..." -ForegroundColor Gray
    Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
    $env:Path += ";$env:USERPROFILE\scoop\shims"
}

if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    Write-Warning "Git not found. Scoop bucket operations may fail."
}

Write-Step "Adding Scoop buckets"
$ScoopBuckets = @({{ range $i, $b := .windows.scoop_buckets.names }}{{ if $i }}, {{ end }}{{ $b | quote }}{{ end }})
foreach ($Bucket in $ScoopBuckets) {
    # Adding an existing bucket is a non-zero no-op, so tolerate that specific case but do
    # not blanket-discard stderr -- a genuine failure here silently breaks every
    # bucket-qualified package below.
    $bucketOutput = scoop bucket add $Bucket 2>&1
    if ($LASTEXITCODE -ne 0 -and $bucketOutput -notmatch 'already exists') {
        $Failed += "scoop bucket $Bucket (exit $LASTEXITCODE): $bucketOutput"
    }
}

Write-Step "Installing Scoop packages"
$ScoopPackages = @(
{{- range $p := .windows.scoop }}
    {{ $p.id | quote }}
{{- end }}
)

foreach ($Package in $ScoopPackages) {
    Write-Host "Installing $Package..." -ForegroundColor Gray
    scoop install $Package
    if ($LASTEXITCODE -ne 0) { $Failed += "scoop $Package (exit $LASTEXITCODE)" }
}

# Report package failures BEFORE the mise step. A failed `scoop install mise` is exactly
# what makes the throw below fire, and the generic "mise not found" message would
# otherwise bury the real cause.
if ($Failed.Count) {
    Write-Host "`nFailed packages:" -ForegroundColor Red
    $Failed | ForEach-Object { Write-Host "  $_" -ForegroundColor Red }
    Write-Host "Re-run 'chezmoi apply' to retry." -ForegroundColor Red
    exit 1
}

# 3. Materialize the declared mise toolchain. This remains in the before phase
# because Windows application packages are provisioned here before their config
# targets are applied.
Write-Step "Installing mise-managed tools"
Refresh-SessionEnvironment
$env:Path = "$env:USERPROFILE\scoop\shims;$env:Path"
if (Get-Command mise -ErrorAction SilentlyContinue) {
    mise install
    # Unchecked previously: a failed toolchain install would leave the machine missing
    # nushell/starship/fastfetch while this script still reported success, and being
    # run_onchange_ it would never retry.
    if ($LASTEXITCODE -ne 0) { throw "mise install failed (exit $LASTEXITCODE)." }
} else {
    throw "mise not found on PATH after scoop install. Open a new shell (or run 'mise install' manually), then re-run 'chezmoi apply'."
}

Write-Host "`nWindows package provisioning completed!" -ForegroundColor Green
{{- end }}
