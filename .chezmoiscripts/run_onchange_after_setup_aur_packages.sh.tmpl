{{- if eq (includeTemplate "is-omarchy" .) "true" -}}
#!/bin/bash
# AUR packages. mise's [bootstrap.packages] has no AUR backend, so this stays a
# script. Omarchy-only: it is the sole desktop Linux this repo targets, and
# these are all desktop packages.
#
# Runs in the AFTER phase, alphabetically after
# run_onchange_after_install_mise_toolchain, which has already applied the
# pacman set that makepkg needs.
set -e

# omarchy-pkg-aur-add is idempotent: it gates on omarchy-pkg-missing, runs
# `yay -S --noconfirm --needed`, then re-verifies each package with `pacman -Q`.
echo "--- Installing/updating AUR packages ---"
omarchy pkg aur add maplemono-nf-unhinted

# Not a bare `omarchy pkg aur add zen-browser-bin`: omarchy-install-browser also
# installs Omarchy's firefox policies.json into /opt/zen-browser/distribution and
# writes MOZ_ENABLE_WAYLAND=1 to ~/.config/environment.d. Both are idempotent.
echo "--- Installing/updating Zen ---"
# omarchy-install-browser has no `set -e` and its three sudo calls are
# unguarded, so it exits 0 even when the policy copy fails. Verify explicitly:
# a run_onchange script only re-fires when its CONTENT changes, so a silent
# failure here would never be retried.
omarchy install browser zen
test -f /opt/zen-browser/distribution/policies.json
test -f "$HOME/.config/environment.d/omarchy-firefox-wayland.conf"

echo "--- AUR packages installed successfully! ---"
{{- end -}}
