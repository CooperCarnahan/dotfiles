{{- if or (eq .osid "linux-arch") (eq .osid "linux-cachyos") -}}
#!/bin/bash
# AUR packages + paru bootstrap. mise's [bootstrap.packages] has no AUR backend
# (AUR needs a helper + source builds), so this survives the mise migration as
# a script. Runs in the AFTER phase, alphabetically after
# run_onchange_after_install_mise_toolchain — which has already applied the
# pacman set (base-devel, git, sudo) that makepkg/paru need.
set -e

aur_packages=(
    "git-credential-manager-bin"
    "ov"
)

{{ if eq (includeTemplate "is-headless" .) "false" -}}
# Desktop apps — skipped on headless machines.
aur_packages+=(
    "1password"
    "gearlever"
    "gnome-browser-connector"
    "handy-bin"
    "hyprmoncfg"
    "maplemono-nf-unhinted"
    "winboat-bin"
)
{{ end -}}

if ! command -v paru >/dev/null 2>&1; then
    echo "--- Bootstrapping paru from the AUR ---"
    tmpdir=$(mktemp -d)
    git clone https://aur.archlinux.org/paru.git "$tmpdir/paru"
    (cd "$tmpdir/paru" && makepkg -si --noconfirm)
    rm -rf "$tmpdir"
fi

echo "--- Installing/updating AUR packages via paru ---"
paru -S --noconfirm --needed "${aur_packages[@]}"

echo "--- Disabling services for replaced daemons ---"
# CachyOS's cachyos-hyprland-settings pulls in mako, whose user .service unit
# is DBus-activated. Without disabling, mako would silently acquire the
# org.freedesktop.Notifications name on first toast and prevent noctalia
# (the notification daemon) from binding. Safe to run repeatedly (idempotent).
systemctl --user disable --now mako.service 2>/dev/null || true

{{ if eq (includeTemplate "is-headless" .) "false" -}}
echo "--- Setting up monitor profile daemon ---"
# Headless-guarded: creating ~/.config/hypr on a headless box would violate the
# .chezmoiignore gate that keeps Wayland configs off servers, and break the
# smoke test that asserts it never appears.

# hyprland.lua does a bare require("monitors"), but hyprmoncfg only writes that
# file when it first applies a profile — so a fresh machine would fail its config
# load before hyprmoncfgd ever runs. Seed an empty (valid Lua) file to break the
# chicken-and-egg; the daemon overwrites it on first apply.
# It must stay a bare require: hyprmoncfg verifies inclusion by parsing
# hyprland.lua and does not recognise pcall(require, ...).
mkdir -p "$HOME/.config/hypr"
[ -f "$HOME/.config/hypr/monitors.lua" ] || : > "$HOME/.config/hypr/monitors.lua"

# hyprmoncfg ships hyprmoncfgd but does not enable it, so nothing would start it
# on a fresh machine and monitor profiles would sit inert.
#
# Upstream's unit is `After=graphical-session.target` but `WantedBy=default.target`.
# After= only orders units inside one transaction — it does not pull the target in
# or hold the unit back — so the documented `systemctl --user enable` starts the
# daemon at login, before Hyprland exists. Its --hypr-config/--monitors-conf
# defaults resolve differently with no compositor running (monitors.conf instead
# of monitors.lua), and Restart=on-failure can burn the start-limit budget and
# park it in `failed` before the session comes up.
#
# Bind it to the graphical session instead — the same wiring hypridle uses here.
# daemon-reload first: paru installed this unit moments ago in this same script.
systemctl --user daemon-reload 2>/dev/null || true
systemctl --user disable hyprmoncfgd.service 2>/dev/null || true
if ! systemctl --user add-wants graphical-session.target hyprmoncfgd.service; then
    echo "WARN: could not wire hyprmoncfgd to graphical-session.target —"
    echo "      monitor profiles will not auto-apply. Check: systemctl --user status hyprmoncfgd"
fi
# Only meaningful when a graphical session is already up; harmless otherwise.
systemctl --user start hyprmoncfgd.service 2>/dev/null || true
{{ end -}}

echo "--- AUR packages installed successfully! ---"
{{- end -}}
