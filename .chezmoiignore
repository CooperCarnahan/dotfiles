# Omarchy owns the Hyprland ENTRYPOINT. It is rewritten by `omarchy refresh
# hyprland` and by migrations during `omarchy update`, which sed/cp/mv
# ~/.config/hypr/*.lua in place. Tracking it replaces that bootstrap, so
# `require("default.hypr.omarchy")` never runs — no bar, no theming, no
# defaults.
#
# Its three user-override seams — bindings.lua, input.lua, looknfeel.lua — are
# deliberately NOT ignored. Omarchy ships them as user-owned stubs and
# hyprland.lua already require()s them, so chezmoi manages them DIRECTLY: no
# hook, no `user/` tree, no require line for a migration to drop.
.config/hypr/hyprland.lua

# Omarchy ships and refreshes .luarc.json, and its version already points
# lua_ls at /usr/share/hypr/stubs with hl and o declared as globals -- the whole
# reason this repo ever tracked one. Ignoring it stops chezmoi and
# `omarchy refresh` rewriting each other over a single extra key.
.config/hypr/.luarc.json

# Per-machine Hyprland overrides (work chat, client VPNs) that must not follow
# the dotfiles to every device. One file per Omarchy user seam, each loaded via
# require_optional from the tracked hypr/<seam>.lua, so `omarchy refresh
# hyprland` overwriting a seam is undone by the next `chezmoi apply` -- the same
# reason those three seams are tracked in the first place (see above).
# require_optional is silent when the file is absent. Maintained out-of-band.
.config/hypr/local-bindings.lua
.config/hypr/local-looknfeel.lua
.config/hypr/local-autostart.lua

# Pure Omarchy state and scaffolding: themes, defaults, branding and the
# `themed/` template overrides are all installed and rewritten by Omarchy
# itself. ~/.config/omarchy is otherwise entirely outside chezmoi.
.config/omarchy/themes
.config/omarchy/themes/**
.config/omarchy/defaults
.config/omarchy/defaults/**
.config/omarchy/branding
.config/omarchy/branding/**
.config/omarchy/themed
.config/omarchy/themed/**

# Omarchy owns and mutates monitors.lua. hyprmoncfg loads its generated layout
# afterward, so persistent monitor changes belong in the tracked JSON profiles.
.config/hypr/monitors.lua

# Generated by hyprmoncfg from the tracked JSON profiles.
.config/hypr/hyprmoncfg-monitors.lua

# Omarchy installs and updates plugin checkouts itself.
.config/omarchy/plugins
.config/omarchy/plugins/**

# Only the profile JSON is tracked -- the .conf/.lua sidecars are regenerated
# exports, and the .lua churns against the StyLua hook.
.config/hyprmoncfg/profiles/*.conf
.config/hyprmoncfg/profiles/*.lua

